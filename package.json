{
  "name": "unplugin-zod-to-mini",
  "version": "0.1.0",
  "description": "Transform Zod schemas to Zod/mini at build time",
  "keywords": [
    "code-generation",
    "rspack",
    "schema",
    "transform",
    "unplugin",
    "vite",
    "webpack",
    "zod",
    "zod to zod/mini"
  ],
  "homepage": "https://github.com/felixmosh/unplugin-zod-to-mini#readme",
  "bugs": {
    "url": "https://github.com/felixmosh/unplugin-zod-to-mini/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixmosh/unplugin-zod-to-mini.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./astro": {
      "types": {
        "import": "./dist/astro.d.mts",
        "require": "./dist/astro.d.cts"
      },
      "import": "./dist/astro.mjs",
      "require": "./dist/astro.cjs"
    },
    "./esbuild": {
      "types": {
        "import": "./dist/esbuild.d.mts",
        "require": "./dist/esbuild.d.cts"
      },
      "import": "./dist/esbuild.mjs",
      "require": "./dist/esbuild.cjs"
    },
    "./farm": {
      "types": {
        "import": "./dist/farm.d.mts",
        "require": "./dist/farm.d.cts"
      },
      "import": "./dist/farm.mjs",
      "require": "./dist/farm.cjs"
    },
    "./nuxt": {
      "types": {
        "import": "./dist/nuxt.d.mts",
        "require": "./dist/nuxt.d.cts"
      },
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    },
    "./rollup": {
      "types": {
        "import": "./dist/rollup.d.mts",
        "require": "./dist/rollup.d.cts"
      },
      "import": "./dist/rollup.mjs",
      "require": "./dist/rollup.cjs"
    },
    "./rspack": {
      "types": {
        "import": "./dist/rspack.d.mts",
        "require": "./dist/rspack.d.cts"
      },
      "import": "./dist/rspack.mjs",
      "require": "./dist/rspack.cjs"
    },
    "./types": {
      "types": {
        "import": "./dist/types.d.mts",
        "require": "./dist/types.d.cts"
      },
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./vite": {
      "types": {
        "import": "./dist/vite.d.mts",
        "require": "./dist/vite.d.cts"
      },
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": {
        "import": "./dist/webpack.d.mts",
        "require": "./dist/webpack.d.cts"
      },
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:zod-metadata": "node scripts/generate-zod-metadata.mjs",
    "build": "tsdown",
    "dev": "tsdown -w",
    "lint": "oxlint .",
    "play": "npm -C playground run dev",
    "prebuild": "npm run generate:zod-metadata",
    "prepublishOnly": "npm run build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "pretest": "npm run generate:zod-metadata",
    "test": "vitest"
  },
  "dependencies": {
    "@swc/core": "^1.15.33",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.17.4",
    "@nuxt/schema": "^3.17.4",
    "@types/node": "^22.15.21",
    "bumpp": "^11.0.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "rollup": "^4.60.3",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "webpack": "^5.106.2"
  },
  "peerDependencies": {
    "@farmfe/core": ">=1",
    "@nuxt/kit": "^3",
    "@nuxt/schema": "^3",
    "esbuild": "*",
    "rollup": "^3",
    "vite": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@farmfe/core": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0"
}
